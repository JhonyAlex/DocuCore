generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BillingStatus {
  PENDING_VERIFICATION
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum BillingSource {
  STRIPE
  MANUAL
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum PlanTransitionStatus {
  PENDING
  APPLIED
  CANCELED
}

enum WorkspaceMemberStatus {
  ACTIVE
  SUSPENDED
  PLAN_LOCKED
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// Roles are persisted per project. Global user fields describe identity only;
// authorization always comes from ProjectMember.
enum ProjectRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
}

model Workspace {
  id                      Int           @id @default(autoincrement())
  name                    String
  slug                    String        @unique
  billingStatus           BillingStatus @default(PENDING_VERIFICATION)
  billingSource           BillingSource @default(STRIPE)
  trialStartedAt          DateTime?
  trialEndsAt             DateTime?
  stripeCustomerId        String?       @unique
  stripeSubscriptionId    String?       @unique
  stripePriceId           String?
  planKey                 String?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean       @default(false)
  graceEndsAt             DateTime?
  planComplianceStartedAt DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  members         WorkspaceMember[]
  projects        Project[]
  auditLogs       AuditLog[]
  planTransitions PlanTransition[]
  invitations     WorkspaceInvitation[]

  @@index([billingStatus, trialEndsAt])
  @@index([stripeCustomerId])
}

model WorkspaceMember {
  id          Int                   @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        WorkspaceRole         @default(MEMBER)
  status      WorkspaceMemberStatus @default(ACTIVE)
  createdAt   DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model PlanTransition {
  id                   String               @id
  workspaceId          Int
  actorId              Int
  targetPlanKey        String
  selectedProjectId    Int
  planLockedProjectIds String[]
  selectedMemberIds    String[]             @default([])
  planLockedMemberIds  String[]             @default([])
  effectiveAt          DateTime?
  appliedAt            DateTime?
  status               PlanTransitionStatus @default(PENDING)
  stripeSessionId      String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

model WorkspaceInvitation {
  id            String                    @id
  workspaceId   Int
  email         String
  workspaceRole WorkspaceRole             @default(MEMBER)
  tokenHash     String                    @unique
  invitedById   Int
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  status        WorkspaceInvitationStatus @default(PENDING)
  createdAt     DateTime                  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInvitations", fields: [invitedById], references: [id], onDelete: Restrict)

  projectRoles WorkspaceInvitationProjectRole[]

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([email])
}

model WorkspaceInvitationProjectRole {
  invitationId String
  projectId    Int
  role         ProjectRole @default(VIEWER)

  invitation WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([invitationId, projectId])
  @@index([projectId])
}

model EmailVerificationToken {
  id        String   @id
  userId    Int
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ProcessedWebhookEvent {
  id          String   @id
  provider    String
  processedAt DateTime @default(now())
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  passwordHash    String
  isActive        Boolean   @default(true)
  role            String
  initials        String
  color           String
  emailVerifiedAt DateTime?
  isPlatformAdmin Boolean   @default(false)
  activeWorkspaceId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assetsOwned             Asset[]                  @relation("AssetResponsible")
  memberships             ProjectMember[]
  workspaceMemberships    WorkspaceMember[]
  auditLogs               AuditLog[]
  planTransitions         PlanTransition[]
  invitedWorkspaceMembers WorkspaceInvitation[]    @relation("WorkspaceInvitations")
  locationsResponsible    Location[]               @relation("LocationResponsible")
  notifications           Notification[]
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([isActive])
  @@index([isPlatformAdmin])
}

// The browser receives an opaque random token. Its SHA-256 digest is the only
// session identifier persisted here, so a database read never exposes a usable
// bearer credential.
model AuthSession {
  id         String   @id
  userId     Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Project {
  id             Int           @id @default(autoincrement())
  workspaceId    Int
  code           String        @unique
  name           String
  description    String
  status         ProjectStatus @default(ACTIVE)
  archivedByPlan Boolean       @default(false)
  planLockedAt   DateTime?
  themeKey       String        @default("blue")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace                      Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  assets                         Asset[]
  members                        ProjectMember[]
  documents                      Document[]
  events                         Event[]
  locations                      Location[]
  assetTypes                     AssetType[]
  documentTypes                  DocumentType[]
  fieldDefinitions               DynamicFieldDefinition[]
  statuses                       Status[]
  tasks                          Task[]
  preventivePlans                PreventivePlan[]
  floorPlans                     FloorPlan[]
  auditLogs                      AuditLog[]
  notifications                  Notification[]
  WorkspaceInvitationProjectRole WorkspaceInvitationProjectRole[]

  @@index([workspaceId, status])
  @@index([status, updatedAt, id])
  @@index([status, createdAt, id])
}

model ProjectMember {
  id        Int         @id @default(autoincrement())
  projectId Int
  userId    Int
  role      ProjectRole
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model AssetType {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  iconKey   String   @default("package")
  color     String   @default("cyan")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project          Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets           Asset[]
  fieldDefinitions DynamicFieldDefinitionAssetType[]
  preventivePlans  PreventivePlanAssetType[]

  @@unique([projectId, name])
  @@index([projectId, isActive, sortOrder])
}

model DocumentType {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  iconKey   String   @default("file-text")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([projectId, name])
  @@index([projectId, isActive, sortOrder])
}

model DynamicFieldDefinition {
  id            Int       @id @default(autoincrement())
  projectId     Int
  key           String
  fieldName     String
  description   String?
  groupName     String    @default("General")
  fieldType     FieldType @default(TEXT)
  required      Boolean   @default(false)
  placeholder   String?
  unit          String?
  minValue      Float?
  maxValue      Float?
  decimalPlaces Int?
  defaultValue  Json?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetTypes    DynamicFieldDefinitionAssetType[]
  options       DynamicFieldOption[]
  values        AssetDynamicFieldValue[]
  dateSchedules AssetDateSchedule[]

  @@unique([projectId, key])
  @@index([projectId, isActive, sortOrder])
}

model DynamicFieldDefinitionAssetType {
  definitionId Int
  assetTypeId  Int

  definition DynamicFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  assetType  AssetType              @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)

  @@id([definitionId, assetTypeId])
  @@index([assetTypeId])
}

model DynamicFieldOption {
  id           Int     @id @default(autoincrement())
  definitionId Int
  key          String
  label        String
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  definition DynamicFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, key])
  @@index([definitionId, sortOrder])
}

model AssetDynamicFieldValue {
  id           Int       @id @default(autoincrement())
  assetId      Int
  definitionId Int
  textValue    String?
  numberValue  Float?
  dateValue    DateTime? @db.Date
  booleanValue Boolean?
  jsonValue    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset        Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  definition   DynamicFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  dateSchedule AssetDateSchedule?

  @@unique([assetId, definitionId])
  @@index([definitionId])
  @@index([dateValue])
}

model Asset {
  id            Int       @id @default(autoincrement())
  code          String
  name          String
  serialNumber  String
  installDate   DateTime
  typeId        Int
  statusId      Int
  locationId    Int
  projectId     Int
  responsibleId Int
  initials      String
  deletedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  images                AssetImage[]
  type                  AssetType                   @relation(fields: [typeId], references: [id])
  status                Status                      @relation(fields: [statusId], references: [id])
  location              Location                    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  project               Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible           User                        @relation("AssetResponsible", fields: [responsibleId], references: [id])
  documentAssets        DocumentItem[]
  events                Event[]
  markers               FloorPlanMarker[]
  dynamicFieldValues    AssetDynamicFieldValue[]
  dateSchedules         AssetDateSchedule[]
  preventivePlans       AssetPreventivePlan[]
  eventAcknowledgements AssetEventAcknowledgement[]

  @@unique([projectId, code])
  @@unique([projectId, serialNumber])
  @@index([typeId])
  @@index([statusId])
  @@index([locationId])
  @@index([projectId])
  @@index([responsibleId])
  @@index([deletedAt])
  @@index([projectId, deletedAt, id])
  @@index([projectId, deletedAt, typeId, statusId])
}

model AssetImage {
  id         Int      @id @default(autoincrement())
  assetId    Int
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, sortOrder])
  @@index([assetId, createdAt])
}

model Status {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  color     String   @default("emerald")
  pulseDot  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets  Asset[]

  @@unique([projectId, name])
  @@index([projectId, isActive, sortOrder])
}

model Document {
  id              Int      @id @default(autoincrement())
  name            String
  eventTitle      String?
  type            String
  typeId          Int?
  periodicity     String?
  periodicityMode String?
  projectId       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assets       DocumentItem[]
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentType DocumentType?     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  versions     DocumentVersion[]

  @@index([projectId])
  @@index([typeId])
  @@index([projectId, updatedAt, id])
}

model DocumentItem {
  documentId Int
  assetId    Int

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([documentId, assetId])
  @@index([assetId])
}

model DocumentVersion {
  id           Int       @id @default(autoincrement())
  documentId   Int
  version      Int
  originalName String
  storageKey   String    @unique
  mimeType     String
  sizeBytes    Int
  issueDate    DateTime
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, uploadedAt])
  @@index([expiryDate])
  @@index([documentId, version(sort: Desc)])
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  date        DateTime
  type        String
  projectId   Int
  assetId     Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assetId])
  @@index([projectId, date])
}

// A catalog task is reusable, while executions retain their own immutable copy.
model Task {
  id        Int      @id @default(autoincrement())
  projectId Int
  code      String
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planTasks PreventivePlanTask[]

  @@unique([projectId, code])
  @@index([projectId, isActive])
}

// Reusable preventive plan template.
model PreventivePlan {
  id              Int      @id @default(autoincrement())
  projectId       Int
  name            String
  description     String?
  periodicity     String
  periodicityMode String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            PreventivePlanTask[]
  assetTypes       PreventivePlanAssetType[]
  assetAssignments AssetPreventivePlan[]

  @@index([projectId, isActive])
}

model PreventivePlanTask {
  planId    Int
  taskId    Int
  sortOrder Int @default(0)

  plan PreventivePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  task Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([planId, taskId])
  @@index([taskId])
}

model PreventivePlanAssetType {
  planId      Int
  assetTypeId Int

  plan      PreventivePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assetType AssetType      @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)

  @@id([planId, assetTypeId])
  @@index([assetTypeId])
}

// Recurrence is an asset assignment concern, never a field-definition concern.
model AssetDateSchedule {
  id              Int      @id @default(autoincrement())
  assetId         Int
  definitionId    Int
  periodicity     String?
  periodicityMode String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset       Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  definition  DynamicFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value       AssetDynamicFieldValue @relation(fields: [assetId, definitionId], references: [assetId, definitionId], onDelete: Cascade)
  occurrences AssetDateOccurrence[]

  @@unique([assetId, definitionId])
  @@index([definitionId])
}

model AssetDateOccurrence {
  id            Int       @id @default(autoincrement())
  scheduleId    Int
  scheduledDate DateTime  @db.Date
  completedAt   DateTime?
  completedDate DateTime? @db.Date
  createdAt     DateTime  @default(now())

  schedule AssetDateSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, completedAt, scheduledDate])
  @@index([scheduledDate])
}

// An assigned preventive plan instance on an asset. Each execution snapshots its own checklist.
model AssetPreventivePlan {
  id              Int      @id @default(autoincrement())
  assetId         Int
  planId          Int?
  name            String
  periodicity     String
  periodicityMode String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset      Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  plan       PreventivePlan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  executions PreventiveExecution[]

  @@index([assetId, isActive])
  @@index([planId])
}

model PreventiveExecution {
  id            Int       @id @default(autoincrement())
  planId        Int
  scheduledDate DateTime  @db.Date
  completedAt   DateTime?
  completedDate DateTime? @db.Date
  createdAt     DateTime  @default(now())

  plan  AssetPreventivePlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks PreventiveExecutionTask[]

  @@index([planId, completedAt, scheduledDate])
  @@index([scheduledDate, completedAt])
}

model PreventiveExecutionTask {
  id          Int       @id @default(autoincrement())
  executionId Int
  taskId      Int?
  code        String
  name        String    @db.VarChar(100)
  sortOrder   Int       @default(0)
  completedAt DateTime?

  execution PreventiveExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, sortOrder])
}

// Documents can be completed from the unified event history without mutating
// their version data. The source key is deliberately generic for future event sources.
model AssetEventAcknowledgement {
  id            Int      @id @default(autoincrement())
  assetId       Int
  sourceKey     String
  completedAt   DateTime @default(now())
  completedDate DateTime @db.Date

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, sourceKey])
  @@index([assetId, completedAt])
}

model Location {
  id            Int      @id @default(autoincrement())
  name          String
  label         String
  code          String
  surface       String
  responsibleId Int
  parentId      Int?
  projectId     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent      Location?   @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Location[]  @relation("LocationTree")
  responsible User        @relation("LocationResponsible", fields: [responsibleId], references: [id])
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets      Asset[]
  floorPlans  FloorPlan[]

  @@unique([projectId, code])
  @@index([parentId])
  @@index([projectId])
  @@index([projectId, parentId])
}

model FloorPlan {
  id         Int      @id @default(autoincrement())
  name       String
  projectId  Int
  locationId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  versions FloorPlanVersion[]
  markers  FloorPlanMarker[]

  @@unique([locationId, name])
  @@index([projectId, locationId])
}

model FloorPlanVersion {
  id           Int      @id @default(autoincrement())
  floorPlanId  Int
  version      Int
  originalName String
  storageKey   String   @unique
  dziKey       String   @unique
  mimeType     String
  sizeBytes    Int
  width        Int
  height       Int
  uploadedAt   DateTime @default(now())

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@unique([floorPlanId, version])
  @@index([floorPlanId, uploadedAt])
}

model FloorPlanMarker {
  id          Int      @id @default(autoincrement())
  floorPlanId Int
  assetId     Int
  x           Float
  y           Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([floorPlanId, assetId])
  @@index([floorPlanId])
  @@index([assetId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  workspaceId Int?
  projectId   Int?
  userId      Int
  action      String
  entityId    String
  detail      String
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId, timestamp(sort: Desc)])
  @@index([projectId, timestamp(sort: Desc)])
  @@index([projectId, userId])
}

model Notification {
  id         Int       @id @default(autoincrement())
  projectId  Int
  userId     Int?
  title      String
  message    String
  category   String // 'expiry' | 'maintenance' | 'status' | 'system'
  urgency    String // 'critical' | 'warning' | 'info'
  targetType String? // 'asset' | 'document' | 'calendar' | 'url'
  targetId   String?
  readAt     DateTime?
  sourceKey  String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, readAt])
  @@index([projectId, createdAt(sort: Desc)])
}
