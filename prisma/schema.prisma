generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String
  initials  String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assetsOwned          Asset[]         @relation("AssetResponsible")
  memberships          ProjectMember[]
  auditLogs            AuditLog[]
  locationsResponsible Location[]      @relation("LocationResponsible")
}

model Project {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  name          String
  description   String
  status        ProjectStatus  @default(ACTIVE)
  gradient      String
  assetCount    Int            @default(0)
  userCount     Int            @default(0)
  locationCount Int            @default(0)
  docCount      Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  assets     Asset[]
  members    ProjectMember[]
  documents  Document[]
  events     Event[]
  locations  Location[]
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  role      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model AssetType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets           Asset[]
  fieldDefinitions DynamicFieldDefinition[]
}

model DynamicFieldDefinition {
  id          Int       @id @default(autoincrement())
  assetTypeId Int
  fieldName   String
  fieldType   FieldType @default(TEXT)
  required    Boolean   @default(false)
  options     String[]
  createdAt   DateTime  @default(now())

  assetType AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)

  @@index([assetTypeId])
}

model Asset {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  name          String
  serialNumber  String    @unique
  installDate   DateTime
  typeId        Int
  statusId      Int
  locationId    Int
  projectId     Int
  responsibleId Int
  initials      String
  dynamicFields Json?
  // ITEM-05: papelera — deletedAt != null significa que el activo está
  // eliminado (recuperable 30 días); la purga lo borra físicamente.
  deletedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  type           AssetType        @relation(fields: [typeId], references: [id])
  status         Status           @relation(fields: [statusId], references: [id])
  location       Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible    User             @relation("AssetResponsible", fields: [responsibleId], references: [id])
  documentAssets DocumentItem[]
  events         Event[]
  markers        FloorPlanMarker[]

  @@index([typeId])
  @@index([statusId])
  @@index([locationId])
  @@index([projectId])
  @@index([responsibleId])
  @@index([deletedAt])
}

model Status {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  pulseDot  String?
  createdAt DateTime @default(now())

  assets Asset[]
}

model Document {
  id         Int      @id @default(autoincrement())
  name       String
  eventTitle String?
  type       String
  projectId  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assets   DocumentItem[]
  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([projectId])
}

// DOC-02: un documento puede estar asociado a varios activos (N-N).
model DocumentItem {
  documentId Int
  assetId    Int

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([documentId, assetId])
  @@index([assetId])
}

model DocumentVersion {
  id           Int      @id @default(autoincrement())
  documentId   Int
  version      Int
  originalName String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  issueDate    DateTime
  expiryDate   DateTime?
  uploadedAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, uploadedAt])
  @@index([expiryDate])
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  date        DateTime
  type        String
  projectId   Int
  assetId     Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset   Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assetId])
}

model Location {
  id            Int      @id @default(autoincrement())
  name          String
  label         String
  code          String   @unique
  surface       String
  responsibleId Int
  parentId      Int?
  projectId     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent      Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Location[] @relation("LocationTree")
  responsible User       @relation("LocationResponsible", fields: [responsibleId], references: [id])
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets      Asset[]
  floorPlan   FloorPlan?

  @@index([parentId])
  @@index([projectId])
}

model FloorPlan {
  id          Int      @id @default(autoincrement())
  name        String
  locationId  Int      @unique
  imageUrl    String
  version     String
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  location Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  markers  FloorPlanMarker[]
}

model FloorPlanMarker {
  id          Int      @id @default(autoincrement())
  floorPlanId Int
  assetId     Int?
  left        Float
  top         Float
  code        String
  label       String
  pinColor    String
  dotColor    String
  animate     Boolean  @default(false)
  createdAt   DateTime @default(now())

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  asset     Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([floorPlanId])
  @@index([assetId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entityId  String
  detail    String
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
