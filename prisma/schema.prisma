generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String
  initials  String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assetsOwned          Asset[]         @relation("AssetResponsible")
  memberships          ProjectMember[]
  auditLogs            AuditLog[]
  locationsResponsible Location[]      @relation("LocationResponsible")
}

model Project {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  name          String
  description   String
  status        ProjectStatus @default(ACTIVE)
  gradient      String
  assetCount    Int           @default(0)
  userCount     Int           @default(0)
  locationCount Int           @default(0)
  docCount      Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  assets           Asset[]
  members          ProjectMember[]
  documents        Document[]
  events           Event[]
  locations        Location[]
  assetTypes       AssetType[]
  fieldDefinitions DynamicFieldDefinition[]
  tasks            Task[]
  preventivePlans  PreventivePlan[]
  floorPlans       FloorPlan[]
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  role      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model AssetType {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  iconKey   String   @default("package")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project          Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets           Asset[]
  fieldDefinitions DynamicFieldDefinitionAssetType[]
  preventivePlans  PreventivePlanAssetType[]

  @@unique([projectId, name])
  @@index([projectId, isActive, sortOrder])
}

model DynamicFieldDefinition {
  id            Int       @id @default(autoincrement())
  projectId     Int
  key           String
  fieldName     String
  description   String?
  groupName     String    @default("General")
  fieldType     FieldType @default(TEXT)
  required      Boolean   @default(false)
  placeholder   String?
  unit          String?
  minValue      Float?
  maxValue      Float?
  decimalPlaces Int?
  defaultValue  Json?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetTypes    DynamicFieldDefinitionAssetType[]
  options       DynamicFieldOption[]
  values        AssetDynamicFieldValue[]
  dateSchedules AssetDateSchedule[]

  @@unique([projectId, key])
  @@index([projectId, isActive, sortOrder])
}

model DynamicFieldDefinitionAssetType {
  definitionId Int
  assetTypeId  Int

  definition DynamicFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  assetType  AssetType              @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)

  @@id([definitionId, assetTypeId])
  @@index([assetTypeId])
}

model DynamicFieldOption {
  id           Int     @id @default(autoincrement())
  definitionId Int
  key          String
  label        String
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  definition DynamicFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, key])
  @@index([definitionId, sortOrder])
}

model AssetDynamicFieldValue {
  id           Int       @id @default(autoincrement())
  assetId      Int
  definitionId Int
  textValue    String?
  numberValue  Float?
  dateValue    DateTime? @db.Date
  booleanValue Boolean?
  jsonValue    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset        Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  definition   DynamicFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  dateSchedule AssetDateSchedule?

  @@unique([assetId, definitionId])
  @@index([definitionId])
  @@index([dateValue])
}

model Asset {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  name            String
  serialNumber    String    @unique
  installDate     DateTime
  typeId          Int
  statusId        Int
  locationId      Int
  projectId       Int
  responsibleId   Int
  initials        String
  deletedAt       DateTime? @db.Timestamptz(6)
  imageStorageKey String?   @unique
  imageMimeType   String?
  imageSizeBytes  Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  type                  AssetType                  @relation(fields: [typeId], references: [id])
  status                Status                     @relation(fields: [statusId], references: [id])
  location              Location                   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  project               Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible           User                       @relation("AssetResponsible", fields: [responsibleId], references: [id])
  documentAssets        DocumentItem[]
  events                Event[]
  markers               FloorPlanMarker[]
  dynamicFieldValues    AssetDynamicFieldValue[]
  dateSchedules         AssetDateSchedule[]
  preventivePlans       AssetPreventivePlan[]
  eventAcknowledgements AssetEventAcknowledgement[]

  @@index([typeId])
  @@index([statusId])
  @@index([locationId])
  @@index([projectId])
  @@index([responsibleId])
  @@index([deletedAt])
}

model Status {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  pulseDot  String?
  createdAt DateTime @default(now())

  assets Asset[]
}

model Document {
  id              Int      @id @default(autoincrement())
  name            String
  eventTitle      String?
  type            String
  periodicity     String?
  periodicityMode String?
  projectId       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assets   DocumentItem[]
  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([projectId])
}

model DocumentItem {
  documentId Int
  assetId    Int

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([documentId, assetId])
  @@index([assetId])
}

model DocumentVersion {
  id           Int       @id @default(autoincrement())
  documentId   Int
  version      Int
  originalName String
  storageKey   String    @unique
  mimeType     String
  sizeBytes    Int
  issueDate    DateTime
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, uploadedAt])
  @@index([expiryDate])
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  date        DateTime
  type        String
  projectId   Int
  assetId     Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assetId])
}

// A catalog task is reusable, while executions retain their own immutable copy.
model Task {
  id        Int      @id @default(autoincrement())
  projectId Int
  code      String
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planTasks PreventivePlanTask[]

  @@unique([projectId, code])
  @@index([projectId, isActive])
}

// Reusable preventive plan template.
model PreventivePlan {
  id              Int      @id @default(autoincrement())
  projectId       Int
  name            String
  description     String?
  periodicity     String
  periodicityMode String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            PreventivePlanTask[]
  assetTypes       PreventivePlanAssetType[]
  assetAssignments AssetPreventivePlan[]

  @@index([projectId, isActive])
}

model PreventivePlanTask {
  planId    Int
  taskId    Int
  sortOrder Int @default(0)

  plan PreventivePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  task Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([planId, taskId])
  @@index([taskId])
}

model PreventivePlanAssetType {
  planId      Int
  assetTypeId Int

  plan      PreventivePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assetType AssetType      @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)

  @@id([planId, assetTypeId])
  @@index([assetTypeId])
}

// Recurrence is an asset assignment concern, never a field-definition concern.
model AssetDateSchedule {
  id              Int      @id @default(autoincrement())
  assetId         Int
  definitionId    Int
  periodicity     String?
  periodicityMode String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset      Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  definition DynamicFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value      AssetDynamicFieldValue @relation(fields: [assetId, definitionId], references: [assetId, definitionId], onDelete: Cascade)
  occurrences AssetDateOccurrence[]

  @@unique([assetId, definitionId])
  @@index([definitionId])
}

model AssetDateOccurrence {
  id            Int       @id @default(autoincrement())
  scheduleId    Int
  scheduledDate DateTime  @db.Date
  completedAt   DateTime?
  completedDate DateTime? @db.Date
  createdAt     DateTime  @default(now())

  schedule AssetDateSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, completedAt, scheduledDate])
}

// An assigned preventive plan instance on an asset. Each execution snapshots its own checklist.
model AssetPreventivePlan {
  id              Int      @id @default(autoincrement())
  assetId         Int
  planId          Int?
  name            String
  periodicity     String
  periodicityMode String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset      Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  plan       PreventivePlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  executions PreventiveExecution[]

  @@index([assetId, isActive])
  @@index([planId])
}

model PreventiveExecution {
  id            Int       @id @default(autoincrement())
  planId        Int
  scheduledDate DateTime  @db.Date
  completedAt   DateTime?
  completedDate DateTime? @db.Date
  createdAt     DateTime  @default(now())

  plan  AssetPreventivePlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks PreventiveExecutionTask[]

  @@index([planId, completedAt, scheduledDate])
}

model PreventiveExecutionTask {
  id          Int       @id @default(autoincrement())
  executionId Int
  taskId      Int?
  code        String
  name        String    @db.VarChar(100)
  sortOrder   Int       @default(0)
  completedAt DateTime?

  execution PreventiveExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, sortOrder])
}

// Documents can be completed from the unified event history without mutating
// their version data. The source key is deliberately generic for future event sources.
model AssetEventAcknowledgement {
  id            Int      @id @default(autoincrement())
  assetId       Int
  sourceKey     String
  completedAt   DateTime @default(now())
  completedDate DateTime @db.Date

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, sourceKey])
  @@index([assetId, completedAt])
}

model Location {
  id            Int      @id @default(autoincrement())
  name          String
  label         String
  code          String   @unique
  surface       String
  responsibleId Int
  parentId      Int?
  projectId     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent      Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Location[] @relation("LocationTree")
  responsible User       @relation("LocationResponsible", fields: [responsibleId], references: [id])
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets      Asset[]
  floorPlans  FloorPlan[]

  @@index([parentId])
  @@index([projectId])
}

model FloorPlan {
  id         Int      @id @default(autoincrement())
  name       String
  projectId  Int
  locationId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location  Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  versions  FloorPlanVersion[]
  markers   FloorPlanMarker[]

  @@unique([locationId, name])
  @@index([projectId, locationId])
}

model FloorPlanVersion {
  id         Int      @id @default(autoincrement())
  floorPlanId Int
  version    Int
  originalName String
  storageKey String   @unique
  dziKey     String   @unique
  mimeType   String
  sizeBytes  Int
  width      Int
  height     Int
  uploadedAt DateTime @default(now())

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@unique([floorPlanId, version])
  @@index([floorPlanId, uploadedAt])
}

model FloorPlanMarker {
  id          Int      @id @default(autoincrement())
  floorPlanId Int
  assetId     Int
  x           Float
  y           Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([floorPlanId, assetId])
  @@index([floorPlanId])
  @@index([assetId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entityId  String
  detail    String
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
