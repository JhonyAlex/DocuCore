{
  "name": "docucore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:landing": "vite build --config landing/vite.config.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:perf": "tsx server/perf.ts",
    "test:smoke": "tsx server/smoke.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx server/seed.ts",
    "db:bootstrap-admin": "tsx server/bootstrap-admin.ts",
    "db:reset:manual-test": "tsx server/reset-manual-test.ts",
    "server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.0.0",
    "@prisma/client": "^5.19.0",
    "@types/multer": "^2.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "lucide-react": "^1.31.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "openseadragon": "^6.1.0",
    "pdfjs-dist": "^6.2.108",
    "prisma": "^5.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.47.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
