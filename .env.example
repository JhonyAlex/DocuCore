# Host development: the Docker PostgreSQL service publishes port 5435.
DATABASE_URL="postgresql://docucore:docucore@127.0.0.1:5435/docucore?schema=public"

# Docker Compose app service: use the internal service hostname and container port.
# DATABASE_URL="postgresql://docucore:docucore@db:5432/docucore?schema=public"

# Optional host ports for Docker Compose.
DB_HOST_PORT=5435
APP_PORT=3001

# Local file storage for document versions. Docker uses its persistent document_data volume.
DOCUMENT_STORAGE_PATH=./data/documents

# Docker Compose PostgreSQL credentials. Change POSTGRES_PASSWORD before deploying.
POSTGRES_USER=docucore
POSTGRES_PASSWORD=docucore
POSTGRES_DB=docucore
