# Host development: the Docker PostgreSQL service publishes port 5435.
DATABASE_URL="postgresql://docucore:docucore@127.0.0.1:5435/docucore?schema=public"

# Docker Compose app service: use the internal service hostname and container port.
# DATABASE_URL="postgresql://docucore:docucore@db:5432/docucore?schema=public"

# Optional host ports for Docker Compose.
DB_HOST_PORT=5435
APP_PORT=3001

# AUTH-01 session cookie. Use a dedicated production name if several DocuCore
# instances share one domain. HTTPS deployments set Secure automatically.
SESSION_COOKIE_NAME=docucore_session
SESSION_TTL_DAYS=14
TRUST_PROXY=true
# Comma-separated browser origins only when the UI is served from another origin.
# CORS_ORIGIN=https://docucore.example.com

# One-time production bootstrap. Docker runs it only while the User table is
# empty; unset both values in normal operation. Never commit a real password.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-character-minimum-secret
# BOOTSTRAP_ADMIN_NAME=Administrador inicial
# BOOTSTRAP_ADMIN_INITIALS=AI

# Local file storage for document versions. Docker uses its persistent document_data volume.
DOCUMENT_STORAGE_PATH=./data/documents

# Docker Compose PostgreSQL credentials. Change POSTGRES_PASSWORD before deploying.
POSTGRES_USER=docucore
POSTGRES_PASSWORD=docucore
POSTGRES_DB=docucore
