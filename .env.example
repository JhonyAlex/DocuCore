# ==============================================================================
# REPORT MAP ONLINE — Configuración de Entorno de Producción
# Dominio canónico: https://report-map.online
# ==============================================================================

# Entorno y Servidor
NODE_ENV=production
PORT=3000
APP_PUBLIC_URL=https://report-map.online
SESSION_SECRET=genera_una_clave_aleatoria_muy_larga_de_minimo_32_caracteres

# Base de Datos PostgreSQL
# En Dokploy o Docker Compose, la URL apunta al servicio db interno
DATABASE_URL=postgresql://docucore:CAMBIAR_ESTA_CONTRASENA_PROD@db:5432/docucore?schema=public

# Credenciales individuales de BD (para docker-compose.prod.yml)
DB_USER=docucore
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA_PROD
DB_NAME=docucore

# Facturación y Suscripciones (Stripe)
# BILLING_PROVIDER: "stripe" para producción, "fake" para pruebas locales
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Servicio de Correo Electrónico
# EMAIL_MODE: "smtp" (producción), "console" (desarrollo), "test" (pruebas unitarias)
EMAIL_MODE=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.tu_api_key_de_produccion...
SMTP_SECURE=false
EMAIL_FROM=Report Map Online <soporte@report-map.online>
EMAIL_FROM_NAME=Report Map Online

# Rutas de Almacenamiento Persistente (Volúmenes Docker)
DOCUMENT_STORAGE_PATH=/app/storage/documents
FLOOR_PLAN_STORAGE_PATH=/app/storage/floor-plans
